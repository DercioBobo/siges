  },
  {
   "fieldname": "pay_advance_months",
   "fieldtype": "Check",
   "label": "Pagar mensalidades do próximo ano",
   "default": "0",
   "description": "Opcional. Active apenas quando a classe do próximo ano for certa."
  },
  {
   "fieldname": "target_school_class",
   "fieldtype": "Link",
   "label": "Classe no Próximo Ano",
   "options": "School Class",
   "depends_on": "eval:doc.pay_advance_months",
   "mandatory_depends_on": "eval:doc.pay_advance_months",
